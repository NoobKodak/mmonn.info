
# Spotify catalog (server/build-time only — never referenced from src/)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=57wPsYZkEErG0C2ntgqNTe
SPOTIFY_MARKET=PH

# Supabase (browser-visible — VITE_ vars are compiled into the public bundle,
# so only ever put the publishable key here, never the secret key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secure Telegram Mini App editor (server-only; never prefix these with VITE_).
# Leave TELEGRAM_ADMIN_IDS blank until you know your numeric Telegram user ID:
# a blank list intentionally denies every account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_SESSION_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Server-side Supabase credentials for the verified editor API only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public HTTPS URLs used by the Telegram bot and editor preview.
PUBLIC_SITE_URL=
TELEGRAM_WEB_APP_URL=
